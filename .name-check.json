{
  "mode": "enforce",
  "allow": [
    "artisanhub-manager",
    "artisanhub\\.managed",
    "artisanhub-push-v1",
    "artisan_hub_[a-z_]+",
    "artisanhub-connector(\\.php)?",
    "ArtisanHub to OpenPrintHQ"
  ],
  "skip": [
    "CHANGELOG*",
    "*/CHANGELOG*",
